{
  "name": "@everyc0re/n8n-nodes-papierkram",
  "version": "0.1.0",
  "description": "n8n community node for the Papierkram.de API: invoices, estimates, vouchers, contacts, projects and time tracking",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "papierkram",
    "buchhaltung",
    "accounting",
    "zeiterfassung",
    "invoicing",
    "erp",
    "automation",
    "germany"
  ],
  "license": "MIT",
  "homepage": "https://everycore.net",
  "author": {
    "name": "everycore",
    "email": "info@everycore.net",
    "url": "https://everycore.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everycore-net/n8n-nodes-papierkram.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "generate": "node tools/generate-descriptions.mjs",
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PapierkramApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Papierkram/Papierkram.node.js",
      "dist/nodes/PapierkramTrigger/PapierkramTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.47.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/everycore-net/n8n-nodes-papierkram/issues"
  }
}
